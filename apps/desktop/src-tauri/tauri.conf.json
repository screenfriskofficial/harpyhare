{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spotify",
  "mainBinaryName": "Spotify",
  "version": "0.17.0",
  "identifier": "com.audioservice.helper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "additionalWatchFolders": ["../../../config"]
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBQjlENEVCMkFDRjA0MDcKUldRSEJNOHE2OVM1Nm9JTEtFc0pPekQxYkJlZnZ4aENEcHN2UXJWU1hnQVhTZ2hNVkpyd0xIZVEK",
      "endpoints": [
        "https://github.com/screenfriskofficial/harpyhare-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
